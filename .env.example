# Placeholder env example for local development
# Use SQLite for development. Keep this value for local usage:
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL) example (set this in your production environment):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Payment gateways (optional)
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Email and JWT
EMAIL_PROVIDER_API_KEY=sendgrid_key_here
JWT_SECRET=your_jwt_secret_here

# Canonical public website URL
NEXT_PUBLIC_SITE_URL="https://www.spicecrowd.in"

# Public map link used in footer/contact
NEXT_PUBLIC_MAP_URL="https://www.google.com/maps/place/Spice+Crowd/@11.3105924,78.3477505,740m/data=!3m2!1e3!4b1!4m6!3m5!1s0x3babb9ca9379a381:0xf9776baf431daa9a!8m2!3d11.3105924!4d78.3503254!16s%2Fg%2F11jjzz55z_?entry=ttu&g_ep=EgoyMDI2MDkwOS4wIKXMDSoASAFQAw%3D%3D"
