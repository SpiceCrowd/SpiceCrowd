# Local secure environment template
# Copy this file to .env.local and fill values for your machine.

# Database
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="replace_with_a_long_random_secret"

# Admin access
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace_with_a_strong_admin_password"

# Payments
RAZORPAY_KEY_ID="replace_with_razorpay_key_id"
RAZORPAY_KEY_SECRET="replace_with_razorpay_key_secret"

# Email provider
EMAIL_PROVIDER_API_KEY="replace_with_email_provider_key"
FROM_EMAIL="noreply@example.com"
INVENTORY_ALERT_EMAIL="inventory@example.com"
PAYMENT_WEBHOOK_SECRET="replace_with_webhook_secret"

# Public URL used by frontend
NEXT_PUBLIC_SITE_URL="https://www.spicecrowd.in"
NEXT_PUBLIC_MAP_URL="https://maps.google.com/..."
