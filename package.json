{
  "name": "spicecrowd-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest --passWithNoTests",
    "test:e2e": "playwright test",
    "smoke:local": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-local.ps1",
    "preflight:env": "node ./scripts/preflight-env.mjs",
    "preflight:local-env": "node ./scripts/preflight-local-env.mjs",
    "dev:ready": "npm run preflight:local-env && npm run smoke:local",
    "release:check": "npm run lint && npm run test && npm run build && npm run preflight:env",
    "release:smoke": "npm run smoke:local",
    "test:watch": "jest --watch",
    "ci": "npm run lint && npm run build && npm test",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "jsonwebtoken": "^9.0.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.1",
    "stripe": "^12.14.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "optionalDependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1"
  },
  "dependenciesMeta": {},
  "devDependencies": {
    "@playwright/test": "^1.39.0",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jest": "^29.6.0",
    "prisma": "^5.10.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/tests/e2e"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
